# Environments
.venv/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# DVC: generated datasets and artifacts are tracked by DVC
# Match a nonempty filename so DVC can still traverse the parent directories.
data/raw/?*
!data/raw/.gitkeep
data/processed/?*
!data/processed/.gitkeep
models/?*
!models/.gitkeep
!data/raw/*.dvc
!data/raw/.gitignore
!data/processed/*.dvc
!data/processed/.gitignore
!models/*.dvc
!models/.gitignore
runs/

# YOLO
*.pt
*.onnx

# Local files
.DS_Store
